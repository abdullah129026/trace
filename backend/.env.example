# Copy to .env for local runs. Never commit a real .env.
# Render sets PORT itself; locally uvicorn defaults to 8000.

# Required for the AI co-pilot only. Leave unset and /explain and /ask
# answer 503; rooms, tracing, and the visualizer all still work.
GROQ_API_KEY=

# Optional. Defaults to llama-3.3-70b-versatile in app/copilot.py.
GROQ_MODEL=
