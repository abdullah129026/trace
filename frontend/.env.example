# Copy to .env.local for local runs. Never commit a real .env.local.
# Next.js bakes NEXT_PUBLIC_* values in at build time, so set this
# before building or deploying, not after.

# Public API base. Local dev: http://localhost:8000.
# Production: the Render backend URL, e.g. https://trace-api.onrender.com
NEXT_PUBLIC_API_URL=
